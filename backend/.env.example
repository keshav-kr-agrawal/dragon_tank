# =============================================================================
# Dragon Tank India - Backend Environment Configuration Template
# =============================================================================
# Copy this file to backend/.env (or root .env) and insert your own valid credentials.
# SECURITY ADVISORY: NEVER commit your actual .env file or production API keys to git!
# =============================================================================

# 1. Google Gemini (Primary Multi-Agent Inference Director)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. OpenAI API (Secondary Multi-LLM Fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 3. ElevenLabs Voice Synthesis (Optional Persona TTS Audio Playback)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# 4. Supabase Credentials (Pitch Sessions & pgvector Market Benchmarks)
# WARNING: Keep SUPABASE_SECRET_KEY / Service Role Key strictly on backend!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# 5. Server Configuration
PORT=8000
HOST=0.0.0.0
