# Environment variables & secrets (DO NOT COMMIT SENSITIVE KEYS)
.env
.env.local
.env.*.local
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.local
frontend/.env*.local

# Allow example templates only
!.env.example
!backend/.env.example
!frontend/.env.example

# Prevent accidental credential, token, and key leakage
*.pem
*.key
*.cert
*.pfx
*.p12
*.id_rsa
*.id_ed25519
credentials.json
service-account*.json
*.token
*.secret
.secrets

# Node dependencies & builds
node_modules/
frontend/node_modules/
.next/
frontend/.next/
frontend/out/
build/
dist/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# Python caches & virtual environments
__pycache__/
backend/__pycache__/
*.py[cod]
*$py.class
*.log
venv/
.venv/
env/
backend/venv/
backend/.venv/

# Operating System & IDE files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
