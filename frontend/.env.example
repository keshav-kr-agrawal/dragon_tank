# =============================================================================
# Dragon Tank India - Frontend Client Environment Configuration
# =============================================================================
# ⚠️ SECURITY NOTICE:
# Any variable prefixed with NEXT_PUBLIC_ is embedded in the public client bundle!
# NEVER put GEMINI_API_KEY, OPENAI_API_KEY, or SUPABASE_SECRET_KEY in frontend files.
# All LLM inference and private operations are proxied securely through FastAPI.
# =============================================================================

NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/pitch
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
