# =============================================================================
# Dragon Tank India - Environment Configuration Template
# =============================================================================
# Copy this file to .env (or backend/.env) and populate with your own keys.
# 
# ⚠️ SECURITY NOTICE:
# - NEVER commit .env, .env.local, or actual secret keys to version control.
# - The backend requires GEMINI_API_KEY (or OPENAI_API_KEY).
# - Client-side secrets (frontend) should NEVER expose master/service-role keys.
# =============================================================================

# 1. Google Gemini (Primary Multi-Agent Inference)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. OpenAI API (Secondary Fallback Router)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 3. ElevenLabs Voice Synthesis (TTS Chunk Audio Playback)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# 4. Supabase Credentials (Sessions & pgvector Knowledge)
# NOTE: Service Role Key stays strictly on the backend server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# 5. Server Configuration
PORT=8000
HOST=0.0.0.0
